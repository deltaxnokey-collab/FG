-- กลไกทำงานของ Toggle
local isOn = false
toggleBtn.MouseButton1Click:Connect(function()
    isOn = not isOn
    if isOn then
        TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(1, -20, 0.5, -9)}):Play()
        TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 0, 0)}):Play()
        print("Toggle Activated!")
    else
        TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -9)}):Play()
        TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
        print("Toggle Deactivated!")
    end
end)

-- กดปุ่ม RightShift เพื่อ ซ่อน/แสดง เมนู
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

