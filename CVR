-- ฟังก์ชันสร้างปุ่มใน Sidebar
local function createTabButton(text, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 32)
    btn.Position = UDim2.new(0, 5, 0, 0)
    btn.BackgroundColor3 = order == 1 and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(35, 35, 35)
    btn.Text = "  " .. text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansSemibold
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.LayoutOrder = order
    btn.Parent = sidebar
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    return btn
end

createTabButton("Player", 1)
createTabButton("Visual", 2)
createTabButton("Combat", 3)
createTabButton("Utilities", 4)
createTabButton("Config", 5)

